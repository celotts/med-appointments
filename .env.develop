# Copia este archivo a `.env` y ajusta los valores.
# `.env` esta en .gitignore y NO debe versionarse: contiene SECRET_KEY y
# contrasenas. Este archivo es la plantilla; aqui los valores son de ejemplo.

# --- Base de datos ---------------------------------------------------------
# Host: localhost si la BD corre en tu maquina.
#       postgres-vector si corres todo en Docker (ver docker-compose.yml).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/med_appointment

# --- Primer superusuario (se crea al arrancar la app) ---------------------
FIRST_SUPERUSER_EMAIL=admin@medapp.com
FIRST_SUPERUSER_PASSWORD=cambia_esta_password

# --- Seguridad / JWT -------------------------------------------------------
# Genera una aleatoria:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=genera_una_clave_secreta_aleatoria

# Sesion en dos tokens:
#   access_token  15 min. Viaja en cada peticion. NO se puede revocar, asi que
#                 se acota su ventana: es lo que limita el daño de un robo.
#   refresh_token 7 dias. Opaco, hasheado en la base, y por tanto revocable.
#
# El arranque RECHAZA un access token de mas de 24 h: 25 h era el valor
# anterior y dejaba la sesión abierta toda una jornada sin poder cerrarla.
# Para sesiones largas esta el refresh token, no alargar el access.
ACCESS_TOKEN_EXPIRE_SECONDS=900
REFRESH_TOKEN_EXPIRE_DAYS=7

# Sesiones simultaneas por usuario. Al superarlo se revoca la mas antigua.
MAX_SESIONES_POR_USUARIO=5

DEBUG=False

# Orígenes permitidos por CORS (JSON)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080"]

# --- Ollama / RAG ----------------------------------------------------------
# Dentro de Docker: http://host.containers.internal:11434
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# OLLAMA_LLM_MODEL=llama3.2
# EMBEDDING_DIM=768