# URL de conexión a la base de datos para desarrollo local (conectando al contenedor Docker)
DATABASE_URL=postgresql+asyncpg://root:fc100711@localhost:5432/appointment

# Variables de entorno para Docker Compose y la aplicación FastAPI

# Credenciales para el primer superusuario que se creará al arrancar la API
# Adaptado de tu proyecto Spring Boot (ADMIN_EMAIL y ADMIN_PASSWORD)
FIRST_SUPERUSER_EMAIL=admin@medapi.com
FIRST_SUPERUSER_PASSWORD=SuperSecretPassword123!
ACCESS_TOKEN_EXPIRE_SECONDS=90000

# Clave secreta para firmar los tokens JWT. Genera una con: openssl rand -hex 32
# Adaptado de tu proyecto Spring Boot (JWT_SECRET)
SECRET_KEY="======================CelottsJWTSecretDefaultDevKey==========================="